{
  "openapi": "3.0.0",
  "info": {
    "title": "test",
    "version": "1.0.0",
    "description": "Stations suggest, train search and schedule. Run the whole folder with the Collection Runner."
  },
  "servers": [
    {
      "url": "http://localhost:8080"
    }
  ],
  "paths": {
    "/api/v1/stations/suggest": {
      "get": {
        "summary": "Suggest - by name prefix (pun)",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "example": "pun"
          }
        ],
        "responses": {},
        "tags": [
          "1. Stations"
        ]
      }
    },
    "/api/v1/trains/search": {
      "get": {
        "summary": "Search - HGL to KWV (happy path)",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "example": "HGL"
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "example": "KWV"
          }
        ],
        "responses": {},
        "tags": [
          "2. Train search"
        ]
      }
    },
    "/api/v1/trains/01488/schedule": {
      "get": {
        "summary": "Schedule - train 01488",
        "responses": {},
        "tags": [
          "3. Train schedule"
        ]
      }
    },
    "/api/v1/trains/99999/schedule": {
      "get": {
        "summary": "Schedule - unknown train -> 404",
        "responses": {},
        "tags": [
          "3. Train schedule"
        ]
      }
    }
  }
}