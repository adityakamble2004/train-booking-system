                "exec": [
                  "pm.test(\"Status is 400\", function () { pm.response.to.have.status(400); });",
                  "pm.test(\"Error code is STATION_REQUIRED\", function () { pm.expect(pm.response.json().code).to.eql(\"STATION_REQUIRED\"); });"
                ]
