                "trains",
                "search"
              ],
              "query": [
                {
                  "key": "from",
                  "value": "KWV"
                },
                {
                  "key": "to",
                  "value": "HGL"
                }
              ]
            }
          }
        },
        {
          "name": "Search - same station -> 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", function () { pm.response.to.have.status(400); });",
                  "pm.test(\"Error code is SAME_STATION\", function () { pm.expect(pm.response.json().code).to.eql(\"SAME_STATION\"); });"
                ]
              }
