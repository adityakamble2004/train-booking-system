
{
  "info": {
    "name": "Payment Testing",
    "description": "Authentication, booking and payment API tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 — Login & Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"fullName\": \"Aditya Kamble\",\n  \"phone\": \"9876543210\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login successful', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const data = pm.response.json();",
                  "if (data.accessToken) {",
                  "  pm.environment.set('userToken', data.accessToken);",
                  "} else if (data.data && data.data.accessToken) {",
                  "  pm.environment.set('userToken', data.data.accessToken);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 — Booking Setup",
      "item": [
        {
          "name": "Create Booking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"trainNo\": \"01488\",\n  \"journeyDate\": \"2026-10-28\",\n  \"fromStation\": \"HGL\",\n  \"toStation\": \"KWV\",\n  \"classCode\": \"SL\",\n  \"contactEmail\": \"{{email}}\",\n  \"contactPhone\": \"9876543210\",\n  \"passengers\": [\n    {\n      \"name\": \"Aditya Kamble\",\n      \"dateOfBirth\": \"2001-08-14\",\n      \"gender\": \"M\",\n      \"berthPreference\": \"LOWER\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/bookings"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Booking created', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "if ([200, 201].includes(pm.response.code)) {",
                  "  const data = pm.response.json();",
                  "  const pnr = data.pnr || (data.data && data.data.pnr);",
                  "  if (pnr) pm.environment.set('pnr', pnr);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Booking",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}"
                }
              ]
            },
            "url": "{{baseUrl}}/bookings/{{pnr}}"
          }
        }
      ]
    },
    {
      "name": "03 — Payment Order & Completion",
      "item": [
        {
          "name": "Create Payment Order",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}"
                }
              ]
            },
            "url": "{{baseUrl}}/bookings/{{pnr}}/payments"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "const orderId = data.orderId || (data.data && data.data.orderId);",
                  "if (orderId) pm.environment.set('orderId', orderId);",
                  "pm.test('Payment order created', function () {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(orderId).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Payment Success",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"outcome\": \"SUCCESS\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/dev/payments/{{orderId}}/complete"
          }
        },
        {
          "name": "Verify Confirmed Booking",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}"
                }
              ]
            },
            "url": "{{baseUrl}}/bookings/{{pnr}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Booking is confirmed', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const data = pm.response.json();",
                  "  pm.expect(data.status || (data.data && data.data.status)).to.eql('CONFIRMED');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Payment Failure",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"outcome\": \"FAILURE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/dev/payments/{{orderId}}/complete"
          }
        }
      ]
    },
    {
      "name": "04 — Refunds & Edge Cases",
      "item": [
        {
          "name": "Payment for Expired Booking",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}"
                }
              ]
            },
            "url": "{{baseUrl}}/bookings/{{pnr}}/payments"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expired booking returns 410', function () {",
                  "  pm.response.to.have.status(410);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Cancel Booking",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}"
                }
              ]
            },
            "url": "{{baseUrl}}/bookings/{{pnr}}/cancel"
          }
        }
      ]
    },
    {
      "name": "05 — Webhook Signature Tests",
      "item": [
        {
          "name": "Invalid Webhook Signature",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Signature",
                "value": "invalid-signature"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{{webhookBody}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/payments/webhook"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Invalid signature rejected', function () {",
                  "  pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Valid Webhook Signature",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Signature",
                "value": "{{webhookSignature}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{{webhookBody}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/payments/webhook"
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081/api/v1"
    },
    {
      "key": "email",
      "value": "aditya@example.com"
    },
    {
      "key": "password",
      "value": "Test1234"
    },
    {
      "key": "userToken",
      "value": ""
    },
    {
      "key": "pnr",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "idempotencyKey",
      "value": "payment-test-001"
    },
    {
      "key": "webhookBody",
      "value": "{\"event\":\"payment.completed\"}"
    },
    {
      "key": "webhookSignature",
      "value": ""
    }
  ]
}
