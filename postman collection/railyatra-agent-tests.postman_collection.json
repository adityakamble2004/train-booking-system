            "url": "{{mainUrl}}/bookings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"trainNo\": \"{{trainNo}}\",\n  \"journeyDate\": \"{{journeyDate}}\",\n  \"fromStation\": \"{{fromStation}}\",\n  \"toStation\": \"{{toStation}}\",\n  \"classCode\": \"SL\",\n  \"contactEmail\": \"{{contactEmail}}\",\n  \"passengers\": [\n    {\n      \"name\": \"{{passengerName}}\",\n      \"dateOfBirth\": \"{{passengerDob}}\",\n      \"gender\": \"{{passengerGender}}\",\n      \"berthPreference\": \"LOWER\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set(\"pnr\", b.pnr);",
                  "pm.test(\"Held, not paid\", () => pm.expect(b.status).to.eql(\"PENDING_PAYMENT\"));"
                ]
