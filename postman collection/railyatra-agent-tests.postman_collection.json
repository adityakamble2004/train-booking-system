      "name": "6. Revoke and audit",
      "item": [
        {
          "name": "6.1 Owner revokes the main assistant",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{mainUrl}}/agent/delegations/{{delegationId}}/revoke",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Now revoked\", () => pm.expect(pm.response.json().status).to.eql(\"REVOKED\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "6.2 Its token stops working immediately",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{mainUrl}}/availability?trainNo={{trainNo}}&date={{journeyDate}}&from={{fromStation}}&to={{toStation}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{agentToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Error code is DELEGATION_INACTIVE\", () => pm.expect(pm.response.json().code).to.eql(\"DELEGATION_INACTIVE\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "6.3 Cannot mint a new token",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{mainUrl}}/agent/delegations/{{delegationId}}/token",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"Error code is DELEGATION_INACTIVE\", () => pm.expect(pm.response.json().code).to.eql(\"DELEGATION_INACTIVE\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "6.4 Audit log shows every call",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{mainUrl}}/agent/delegations/{{delegationId}}/actions?size=100",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const a = pm.response.json();",
                  "pm.test(\"Has entries\", () => pm.expect(a.totalElements).to.be.above(0));",
                  "pm.test(\"Contains refused calls\", () => pm.expect(a.content.some(x => x.statusCode === 403)).to.eql(true));"
                ]
              }
            }
          ]
        }
      ]
