{
  "info": {
    "name": "Railyatra - AI assistant (delegation) tests",
    "description": "Tests the delegation, scopes, allowlist, limits, revoke and audit of the AI assistant. Edit the variables on the collection, then run the whole collection in order.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "mainUrl",
      "value": "http://localhost:8081/api/v1"
    },
    {
      "key": "publicUrl",
      "value": "http://localhost:8080/api/v1"
    },
    {
      "key": "email",
      "value": "aditya@example.com"
    },
    {
      "key": "password",
      "value": "Test1234"
    },
    {
      "key": "trainNo",
      "value": "01488"
    },
    {
      "key": "fromStation",
      "value": "HGL"
    },
    {
      "key": "toStation",
      "value": "KWV"
    },
    {
      "key": "journeyDate",
      "value": ""
    },
    {
      "key": "passengerName",
      "value": ""
    },
    {
      "key": "passengerDob",
      "value": ""
    },
    {
      "key": "passengerGender",
      "value": ""
    },
    {
      "key": "contactEmail",
      "value": ""
    },
    {
      "key": "userToken",
      "value": ""
    },
    {
      "key": "agentToken",
      "value": ""
    },
    {
      "key": "delegationId",
      "value": ""
    },
    {
      "key": "pnr",
      "value": ""
    },
    {
      "key": "delegationIdNoBook",
      "value": ""
    },
    {
      "key": "tokenNoBook",
      "value": ""
    },
    {
      "key": "delegationIdTiny",
      "value": ""
    },
    {
      "key": "tokenTiny",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Setup (as owner)",
      "item": [
        {
          "name": "0.1 Login as owner",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{mainUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set(\"userToken\", b.accessToken);",
                  "pm.collectionVariables.set(\"contactEmail\", b.user.email);"
                ]
              }
            }
          ]
        },
        {
          "name": "0.2 Find an open journey date",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{mainUrl}}/journeys/open-dates?trainNo={{trainNo}}",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const d = pm.response.json();",
                  "pm.test(\"At least one open date (open one with the admin API first)\", () => pm.expect(d.length).to.be.above(0));",
                  "if (d.length) { pm.collectionVariables.set(\"journeyDate\", d[0]); }"
                ]
              }
            }
          ]
        },
        {
          "name": "0.3 Read your first saved passenger",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{mainUrl}}/users/me/passengers"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const p = pm.response.json();",
                  "pm.test(\"You have at least one saved passenger\", () => pm.expect(p.length).to.be.above(0));",
                  "if (p.length) { pm.collectionVariables.set(\"passengerName\", p[0].name); pm.collectionVariables.set(\"passengerDob\", p[0].dateOfBirth); pm.collectionVariables.set(\"passengerGender\", p[0].gender); }"
                ]
              }
            }
          ]
        },
        {
          "name": "0.4 Create the main test assistant",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{mainUrl}}/agent/delegations",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test assistant\",\n  \"scopes\": [\n    \"search\",\n    \"read_profile\",\n    \"read_passengers\",\n    \"book\",\n    \"read_bookings\",\n    \"cancel\"\n  ],\n  \"maxFarePerBookingPaise\": 50000,\n  \"maxSpend24hPaise\": 100000,\n  \"maxPassengers\": 2,\n  \"allowedClasses\": [\n    \"SL\"\n  ],\n  \"savedPassengersOnly\": true,\n  \"validDays\": 7\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"delegationId\", pm.response.json().id);",
                  "pm.test(\"Is usable\", () => pm.expect(pm.response.json().usable).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "0.5 Mint the assistant's token",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{mainUrl}}/agent/delegations/{{delegationId}}/token"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"agentToken\", pm.response.json().accessToken);"
                ]
              }
            }
          ]
        }
      ],
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{userToken}}",
            "type": "string"
          }
        ]
      },
      "description": "Run these first. They log in, pick an open date and a saved passenger, create the assistant and mint its token."
    },
    {
